# 默认配置可启动健康接口；账号和家庭接口须先配置并迁移本项目独立数据库。
# 环境变量优先于本文件复制得到的 backend/.env。
HOMEMIND_ENVIRONMENT=development
HOMEMIND_API_HOST=127.0.0.1
HOMEMIND_API_PORT=8100

# M3 requires this project's independently provisioned MySQL installation.
# Generate credentials locally; never copy an old project's database URL.
# HOMEMIND_DATABASE_URL=mysql+asyncmy://homemind_app:LOCAL_PASSWORD@127.0.0.1:13306/homemind_app
# HOMEMIND_DATABASE_INSTANCE_ID=LOCAL_INSTALLATION_UUID
HOMEMIND_SIMULATION_DEBUG_ENABLED=false
